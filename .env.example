# ---- Database ----
# Dev: SQLite (file path). Prod: switch prisma/schema.prisma provider to "postgresql"
# and set DATABASE_URL to a Postgres connection string, then `bun run db:migrate`.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---- Auth ----
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# bcrypt hash; generate: bun run scripts/hash-password.ts "yourpassword"
ADMIN_PASSWORD_HASH=
# (dev-only fallback — prefer ADMIN_PASSWORD_HASH; a warning is logged when this is used)
ADMIN_PASSWORD=

# ---- Email (optional — contact form saves to DB regardless of email config) ----
CONTACT_NOTIFICATION_EMAIL=you@example.com
# Option A — Resend (REST API via fetch, no SDK):
RESEND_API_KEY=
RESEND_FROM=Portfolio <noreply@example.com>
# Option B — SMTP (nodemailer):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Spam (optional) ----
# Cloudflare Turnstile server secret — only verified if set.
TURNSTILE_SECRET=

# ---- Static Export (GitHub Pages) ----
# Set to true ONLY for GitHub Pages static build. Leave empty for full-stack mode.
# See DEPLOYMENT.md. The build script (scripts/build-static.sh) sets these automatically.
STATIC_EXPORT=
NEXT_PUBLIC_STATIC_EXPORT=
# Your GitHub repo name, e.g. my-portfolio (for username.github.io/my-portfolio).
# Leave empty for user/org sites (username.github.io).
NEXT_PUBLIC_BASE_PATH=
